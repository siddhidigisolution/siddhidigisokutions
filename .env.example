# EmailJS (https://www.emailjs.com) — powers the Contact section's form.
# Copy this file to .env.local, fill in the three values from your EmailJS
# dashboard, and restart `npm run dev`. Without them the form shows a
# friendly "not set up yet" error instead of submitting.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
